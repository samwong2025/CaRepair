# ─── Supabase 連線設定 ───────────────────────────────
# 於 Supabase 專案 Settings → API 取得下列數值後，
# 將本檔複製為 .env.local 並填入即可自動由 Mock 切換至雲端資料庫。

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 後台管理端使用（僅在伺服器端讀取，切勿加 NEXT_PUBLIC_ 前綴）
SUPABASE_SERVICE_ROLE_KEY=

# ─── 後台登入（Mock 模式專用） ───────────────────────
# 未連 Supabase 時，後台以密碼登入（種 cookie 守衛）。
# 連上 Supabase 後自動改用 Supabase Auth，本項失效。
ADMIN_PASSWORD=admin123
